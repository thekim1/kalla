{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalla.local/contracts/parser/v1/info.schema.json",
  "$defs": {
    "Capacity": {
      "properties": {
        "convert_slots": {
          "title": "Convert Slots",
          "type": "integer"
        },
        "slots_ready": {
          "title": "Slots Ready",
          "type": "integer"
        },
        "inspect_slots": {
          "title": "Inspect Slots",
          "type": "integer"
        },
        "ner_ready": {
          "title": "Ner Ready",
          "type": "boolean"
        }
      },
      "required": [
        "convert_slots",
        "slots_ready",
        "inspect_slots",
        "ner_ready"
      ],
      "title": "Capacity",
      "type": "object"
    },
    "Formats": {
      "properties": {
        "supported": {
          "items": {
            "type": "string"
          },
          "title": "Supported",
          "type": "array"
        },
        "deferred": {
          "items": {
            "type": "string"
          },
          "title": "Deferred",
          "type": "array"
        }
      },
      "required": [
        "supported",
        "deferred"
      ],
      "title": "Formats",
      "type": "object"
    },
    "Limits": {
      "properties": {
        "max_body_bytes": {
          "title": "Max Body Bytes",
          "type": "integer"
        },
        "max_pages_per_request": {
          "title": "Max Pages Per Request",
          "type": "integer"
        },
        "max_pages_per_document": {
          "title": "Max Pages Per Document",
          "type": "integer"
        },
        "max_deadline_ms": {
          "title": "Max Deadline Ms",
          "type": "integer"
        },
        "inspect_deadline_ms": {
          "title": "Inspect Deadline Ms",
          "type": "integer"
        },
        "max_zip_entries": {
          "title": "Max Zip Entries",
          "type": "integer"
        },
        "max_zip_uncompressed_bytes": {
          "title": "Max Zip Uncompressed Bytes",
          "type": "integer"
        },
        "max_zip_ratio": {
          "title": "Max Zip Ratio",
          "type": "integer"
        },
        "max_image_pixels": {
          "title": "Max Image Pixels",
          "type": "integer"
        },
        "max_tiff_frames": {
          "title": "Max Tiff Frames",
          "type": "integer"
        },
        "max_render_pixels": {
          "title": "Max Render Pixels",
          "type": "integer"
        },
        "max_spreadsheet_cells": {
          "title": "Max Spreadsheet Cells",
          "type": "integer"
        },
        "ner_max_texts": {
          "title": "Ner Max Texts",
          "type": "integer"
        },
        "ner_max_text_chars": {
          "title": "Ner Max Text Chars",
          "type": "integer"
        },
        "ner_max_request_chars": {
          "title": "Ner Max Request Chars",
          "type": "integer"
        },
        "ner_deadline_ms": {
          "title": "Ner Deadline Ms",
          "type": "integer"
        }
      },
      "required": [
        "max_body_bytes",
        "max_pages_per_request",
        "max_pages_per_document",
        "max_deadline_ms",
        "inspect_deadline_ms",
        "max_zip_entries",
        "max_zip_uncompressed_bytes",
        "max_zip_ratio",
        "max_image_pixels",
        "max_tiff_frames",
        "max_render_pixels",
        "max_spreadsheet_cells",
        "ner_max_texts",
        "ner_max_text_chars",
        "ner_max_request_chars",
        "ner_deadline_ms"
      ],
      "title": "Limits",
      "type": "object"
    },
    "Model": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "licence": {
          "title": "Licence",
          "type": "string"
        },
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "path → SHA-256",
          "title": "Files",
          "type": "object"
        }
      },
      "required": [
        "name",
        "repository",
        "revision",
        "licence",
        "files"
      ],
      "title": "Model",
      "type": "object"
    },
    "NerModel": {
      "properties": {
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "sha256": {
          "description": "of the weights file",
          "title": "Sha256",
          "type": "string"
        },
        "labels": {
          "description": "the model's own labels",
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "person_labels": {
          "description": "model labels mapped to `person`",
          "items": {
            "type": "string"
          },
          "title": "Person Labels",
          "type": "array"
        },
        "quantised": {
          "title": "Quantised",
          "type": "boolean"
        }
      },
      "required": [
        "repository",
        "revision",
        "sha256",
        "labels",
        "person_labels",
        "quantised"
      ],
      "title": "NerModel",
      "type": "object"
    },
    "ParserVersion": {
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "version",
        "revision"
      ],
      "title": "ParserVersion",
      "type": "object"
    },
    "Pdfium": {
      "properties": {
        "build": {
          "title": "Build",
          "type": "integer"
        },
        "origin": {
          "title": "Origin",
          "type": "string"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "build",
        "origin",
        "flags"
      ],
      "title": "Pdfium",
      "type": "object"
    },
    "Tesseract": {
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        }
      },
      "required": [
        "version",
        "languages"
      ],
      "title": "Tesseract",
      "type": "object"
    }
  },
  "description": "`GET /v1/info`.",
  "properties": {
    "parser": {
      "$ref": "#/$defs/ParserVersion"
    },
    "python": {
      "title": "Python",
      "type": "string"
    },
    "packages": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Packages",
      "type": "object"
    },
    "pdfium": {
      "$ref": "#/$defs/Pdfium"
    },
    "tesseract": {
      "anyOf": [
        {
          "$ref": "#/$defs/Tesseract"
        },
        {
          "type": "null"
        }
      ]
    },
    "models": {
      "items": {
        "$ref": "#/$defs/Model"
      },
      "title": "Models",
      "type": "array"
    },
    "ner": {
      "anyOf": [
        {
          "$ref": "#/$defs/NerModel"
        },
        {
          "type": "null"
        }
      ],
      "description": "the NER model as `ner-0` loads it; null when NER is off"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "formats": {
      "$ref": "#/$defs/Formats"
    },
    "build_hash": {
      "description": "SHA-256 of everything except capacity",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Build Hash",
      "type": "string"
    },
    "capacity": {
      "$ref": "#/$defs/Capacity"
    }
  },
  "required": [
    "parser",
    "python",
    "packages",
    "pdfium",
    "tesseract",
    "models",
    "ner",
    "limits",
    "formats",
    "build_hash",
    "capacity"
  ],
  "title": "Info",
  "type": "object"
}
