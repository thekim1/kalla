{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalla.local/contracts/pipeline/v2/definition.schema.json",
  "title": "Pipeline definition",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "pipeline/v2"
    },
    "template": {
      "type": "string",
      "description": "Template name, e.g. website.",
      "pattern": "^[a-z][a-z0-9-]{0,49}$"
    },
    "templateVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "params": {
      "type": "object",
      "description": "Parameter values by name; at most 16 KB of JSON (§4 rule 1).",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]{0,49}$"
      },
      "default": {}
    }
  },
  "required": [
    "schema",
    "template",
    "templateVersion"
  ],
  "additionalProperties": false,
  "description": "A pipeline version: template, template version and parameters (engine design §3.1). The parameters are checked against the template version's parameter schemas (§4 rule 3)."
}
