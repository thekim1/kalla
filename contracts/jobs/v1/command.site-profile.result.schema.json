{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ume-rag.local/contracts/jobs/v1/command.site-profile.result.schema.json",
  "title": "edit-site-profile and rollback-site-profile command result",
  "type": "object",
  "properties": {
    "siteProfileId": {
      "type": "string",
      "format": "uuid"
    },
    "appliedVersionId": {
      "type": "string",
      "format": "uuid"
    },
    "appliedVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  },
  "required": [
    "siteProfileId",
    "appliedVersionId",
    "appliedVersion"
  ],
  "description": "Result of the commands edit-site-profile and rollback-site-profile: the version now applied (SiteProfiles.AppliedVersionId)."
}
