# The variables of v0.5.1's deploy/portainer/stack.env.example (comments removed, each CHANGE given a value; the
# gateway keys and Open WebUI's client left empty, as on a first start): what a 0.5.x deployment has in its stack.
# deploy/tests/portainer-upgrade.sh renders the current stack file with them, and
# deploy/tests/portainer-upgrade-boot.sh boots v0.5.1's stack with them and applies the current file over it.
UME_OIDC_AUTHORITY=https://keycloak.example.se/realms/ume
UME_GATEWAY_HOST=llm.example.se
UME_GATEWAY_PUBLIC_URL=https://llm.example.se
UME_ADMIN_HOST=llm-admin.example.se
COMPOSE_PROFILES=clamav,openwebui
UME_RAG_API_HOST=rag.example.se
UME_RAG_API_PUBLIC_URL=https://rag.example.se
UME_RAG_ADMIN_HOST=rag-admin.example.se
UME_RAG_EMBEDDING_MODEL=an-embedding-model
UME_RAG_OIDC_CLIENT_SECRET=a-value
UME_RAG_OIDC_GROUPS_PLATFORM_ADMIN=a-value
UME_RAG_API_GATEWAY_KEY=
UME_RAG_ADMIN_GATEWAY_KEY=
UME_RAG_WORKER_GATEWAY_KEY=
UME_RAG_OPENWEBUI_HOST=chat.example.se
UME_RAG_OPENWEBUI_OIDC_CLIENT_ID=open-webui
UME_RAG_OPENWEBUI_OIDC_CLIENT_SECRET=a-value
UME_RAG_OPENWEBUI_API_KEY=
UME_RAG_OPENWEBUI_CLIENT_ID=
