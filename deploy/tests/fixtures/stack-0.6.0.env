# The variables of v0.6.0's deploy/portainer/stack.env.example (comments removed, the two CHANGE secrets given a value):
# what a 0.6.0 deployment has in its stack. deploy/tests/portainer-upgrade.sh renders the current stack file with them.
UME_OIDC_AUTHORITY=https://keycloak.example.se/realms/ume
UME_GATEWAY_HOST=llm.example.se
UME_GATEWAY_PUBLIC_URL=https://llm.example.se
UME_ADMIN_HOST=llm-admin.example.se
COMPOSE_PROFILES=clamav,openwebui
UME_RAG_API_HOST=rag.example.se
UME_RAG_ADMIN_HOST=rag-admin.example.se
UME_RAG_OIDC_CLIENT_SECRET=a-client-secret
UME_INTEGRATION_MANIFEST={"schemaVersion":1,"integration":{"name":"Ume.Rag","description":"Ume.Rag retrieval platform","owner":{"teamCode":"ume-rag","teamName":"Ume.Rag","departmentCode":"ume-rag","departmentName":"Ume.Rag"}},"credentialKeys":[{"name":"rag-api","allowedResidencies":["OnPrem","Eu"],"requireMaxResidency":true,"piiPolicy":"Off","allowedIpRanges":[]},{"name":"rag-admin","integrationScopes":["organisation.read","usage.read"],"allowedResidencies":["OnPrem","Eu"],"requireMaxResidency":true,"piiPolicy":"Off","allowedIpRanges":[]},{"name":"rag-worker","allowedResidencies":["OnPrem","Eu"],"requireMaxResidency":true,"piiPolicy":"Off","allowedIpRanges":[]}]}
UME_INTEGRATION_API_URL=https://adminapi:8443/integration/v1
UME_RAG_OPENWEBUI_HOST=chat.example.se
UME_RAG_OPENWEBUI_OIDC_CLIENT_ID=open-webui
UME_RAG_OPENWEBUI_OIDC_CLIENT_SECRET=a-client-secret
