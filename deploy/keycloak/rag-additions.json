{
  "roles": {
    "realm": [
      {
        "name": "rag-platform-admin"
      },
      {
        "name": "rag-department-admin"
      },
      {
        "name": "rag-pipeline-editor"
      },
      {
        "name": "rag-reviewer"
      },
      {
        "name": "rag-skill-editor",
        "description": "P2 (tools design §3.6)"
      },
      {
        "name": "rag-editor",
        "description": "P2"
      },
      {
        "name": "rag-viewer"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ume-rag-admin",
      "name": "Ume.Rag admin (rag-admin BFF)",
      "description": "The admin UI and admin API (identity design 11.2). Redirect URIs: the pilot host (the local AppHost ones are in rag-additions.local.json).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${UME_RAG_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "https://${UME_RAG_ADMIN_PUBLIC_HOST}/signin-oidc"
      ],
      "webOrigins": [
        "https://${UME_RAG_ADMIN_PUBLIC_HOST}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${UME_RAG_ADMIN_PUBLIC_HOST}/signout-callback-oidc"
      },
      "protocolMappers": [
        {
          "name": "rag-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "departmentCodes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "departmentCodes",
            "claim.name": "departmentCodes",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "teamCodes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "teamCodes",
            "claim.name": "teamCodes",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "open-webui",
      "name": "Open WebUI (OIDC sign-in)",
      "description": "Open WebUI's own sign-in (identity design 5.3, 11.2): the legacy callback path. Redirect URIs: the pilot host (the local AppHost ones are in rag-additions.local.json).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${UME_RAG_OPENWEBUI_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "https://${UME_RAG_OPENWEBUI_HOST}/oauth/oidc/callback"
      ],
      "webOrigins": [
        "https://${UME_RAG_OPENWEBUI_HOST}"
      ]
    },
    {
      "clientId": "ume-rag-api",
      "name": "Ume.Rag API (audience)",
      "description": "The audience of RAG API tokens (RagApi:Audience, identity design 7.1). No flow of its own: P1 chat goes through Open WebUI with a key and a user JWT.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "scopeMappings": [
    {
      "client": "ume-rag-admin",
      "roles": [
        "rag-platform-admin",
        "rag-department-admin",
        "rag-pipeline-editor",
        "rag-reviewer",
        "rag-skill-editor",
        "rag-editor",
        "rag-viewer"
      ]
    }
  ]
}
