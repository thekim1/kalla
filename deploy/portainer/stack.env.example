# Variables for deploy/portainer/compose.portainer.yaml (the gateway and Ume.Rag as one Portainer stack).
# In Portainer: Stacks > your stack > Environment variables > "Load variables from .env file", then edit the values.
# One line is marked CHANGE and needs your value; the commented lines show the defaults and can stay commented.
# Steps and background: docs/portainer.md. After the first start, rag-bootstrap's log lists what is still missing.
# Then set up sign-in in two setup wizards, the gateway's first: open https://llm-admin.<domain>/setup with the setup
# code from adminapi's log (Containers > adminapi > Logs), then https://rag-admin.<domain>/setup with the setup code
# from rag-admin's log. The wizards take the provider and the client secrets, so none is typed here.
# The image variables (GATEWAY_IMAGE, RAG_API_IMAGE, ...) are not needed: the stack file pins them.

# ---- The domain ------------------------------------------------------------------------------------------------------
# CHANGE: your domain; the host names default to llm.<domain> (the gateway), llm-admin.<domain> (its admin),
# rag.<domain>, rag-admin.<domain> and, with the openwebui profile, chat.<domain>
UME_DOMAIN=example.se

# ---- The gateway -----------------------------------------------------------------------------------------------------
# public host name of the gateway API, only to override llm.<domain>
#UME_GATEWAY_HOST=llm.example.se
# its public URL when it is not https://<the gateway's host name> (a port)
#UME_GATEWAY_PUBLIC_URL=https://llm.example.se:8443
# public host name of the gateway's admin, only to override llm-admin.<domain>
#UME_ADMIN_HOST=llm-admin.example.se
# the gateway admin's public URL, for a port: Ume.Rag's admin links to https://<its host name> without it, and with it
# the gateway hands the address to integrations too
#UME_ADMIN_PUBLIC_URL=https://llm-admin.example.se:9443
# Sign-in to the gateway's admin: its setup wizard, or declared here. A provider set here is the deployment's for the
# gateway and for Ume.Rag's admin, is shown locked in both wizards and keeps the gateway's wizard closed.
#UME_OIDC_AUTHORITY=https://keycloak.example.se/realms/ume
#UME_OIDC_CLIENT_ID=ume-admin
# only for a confidential ume-admin client, and only together with UME_OIDC_AUTHORITY
#UME_OIDC_CLIENT_SECRET=
# give it any new value, for example today's date, and update the stack to open the gateway's setup wizard again;
# adminapi then prints a new setup code
#UME_SETUP_REOPEN=
# groups that grant the gateway's roles (';'-separated)
#UME_OIDC_GROUPS_GATEWAY_ADMIN=
#UME_OIDC_GROUPS_DEPARTMENT_ADMIN=
#UME_OIDC_GROUPS_TEAM_ADMIN=
#UME_OIDC_GROUPS_VIEWER=
#UME_GATEWAY_PORT=8443
#UME_ADMIN_PORT=9443
#UME_GATEWAY_BIND=0.0.0.0
#UME_ADMIN_BIND=0.0.0.0
# OTLP collector; empty = no telemetry export
#UME_OTEL_ENDPOINT=

# ---- Profiles ----------------------------------------------------------------------------------------------------
# clamav: the malware scan (the worker expects it); render: JavaScript pages; openwebui: Open WebUI as the chat for
# users, for an installation that wants one (without it Ume.Rag serves its API to your own applications, and nothing
# of Open WebUI is created); proxy: nginx with your certificate in front.
COMPOSE_PROFILES=clamav
# With the chat:
#COMPOSE_PROFILES=clamav,openwebui

# ---- Ume.Rag -----------------------------------------------------------------------------------------------------
# public host name of rag-api, only to override rag.<domain>
#UME_RAG_API_HOST=rag.example.se
# its public URL when it is not https://<rag-api's host name> (a port); citation links are absolute
#UME_RAG_API_PUBLIC_URL=https://rag.example.se:8543
# public host name of Ume.Rag's admin, only to override rag-admin.<domain>
#UME_RAG_ADMIN_HOST=rag-admin.example.se
# Roles come from the token's roles claim (Keycloak: the realm role rag-platform-admin). Only for an identity provider
# whose tokens carry groups instead: the break-glass group(s) for the first platform admin; the other roles' groups are
# set in RAG's admin (Settings, Role groups)
#UME_RAG_OIDC_GROUPS_PLATFORM_ADMIN=
#UME_RAG_API_PORT=8543
#UME_RAG_ADMIN_PORT=9543
#UME_RAG_API_BIND=0.0.0.0
#UME_RAG_ADMIN_BIND=0.0.0.0
# private CIDRs the crawler may fetch
#UME_RAG_CRAWL_ALLOW=
# give it any new value, for example today's date, and update the stack to open the setup wizard again; rag-admin then
# prints a new setup code
#UME_RAG_SETUP_REOPEN=

# The gateway integration Ume.Rag and its three credential keys are created by the gateway's migrations from the stack
# file's default manifest, on every deploy where missing (an existing integration or key, found by name, is never
# changed); rag-bootstrap gives each service its key, nothing to paste (M-17 C7). Every key is limited to OnPrem and Eu
# (register M2: that is Ume.Rag's residency ceiling). The integration lands in a team and department of its own
# (ume-rag); a gateway admin moves it to your own team under Integrations. Only to place it in an existing team at
# once, set your own manifest: one line of JSON, deploy/portainer/integration-manifest.json with an "owner"
# ({"teamCode":...,"teamName":...,"departmentCode":...,"departmentName":...}) in "integration". Set and empty, nothing
# is created (keys issued by hand, below).
#UME_INTEGRATION_MANIFEST=
# The Integration API as rag-admin reaches it (the gateway's costs and budgets in Ume.Rag's admin)
UME_INTEGRATION_API_URL=https://adminapi:8443/integration/v1
# Keys issued by hand instead (or a gateway elsewhere): set, a variable wins over the manifest's key.
#UME_RAG_API_GATEWAY_KEY=
#UME_RAG_ADMIN_GATEWAY_KEY=
#UME_RAG_WORKER_GATEWAY_KEY=

# ---- Open WebUI (profile openwebui) --------------------------------------------------------------------------------
# public host name of the chat, only to override chat.<domain>
#UME_RAG_OPENWEBUI_HOST=chat.example.se
# Its sign-in: the setup wizard's Open WebUI step, or the variables under "Sign-in" below.
# plain HTTP: keep it behind your TLS proxy
#UME_RAG_OPENWEBUI_BIND=127.0.0.1
#UME_RAG_OPENWEBUI_PORT=3000
# The feedback import needs nothing: rag-openwebui-setup mints its key.

# ---- Sign-in: the setup wizard, or declared here -------------------------------------------------------------------
# Two ways, per value:
# - The setup wizard (leave these out): after the first start, open https://rag-admin.<domain>/setup with the setup
#   code from rag-admin's log. It shows the redirect URIs to register, takes the client secrets and tests each sign-in.
# - Declared: a value set here is the deployment's and is shown locked in the wizard. With an authority (rag-admin
#   takes UME_OIDC_AUTHORITY above, or UME_RAG_OIDC_AUTHORITY) and UME_RAG_OIDC_CLIENT_SECRET the wizard never opens.
#   Without an authority here, rag-admin's wizard suggests the one saved in the gateway's wizard.
# Ume.Rag admin's OIDC client (default ume-rag-admin); redirect URIs https://<admin host>/signin-oidc and
# /signout-callback-oidc
#UME_RAG_OIDC_AUTHORITY=
#UME_RAG_OIDC_CLIENT_ID=ume-rag-admin
#UME_RAG_OIDC_CLIENT_SECRET=
# The token's shape (defaults: roles, departmentCodes, teamCodes, groups, guests refused); Entra ID: the tenant id
#UME_RAG_OIDC_ROLE_CLAIM=roles
#UME_RAG_OIDC_DEPARTMENT_CLAIM=departmentCodes
#UME_RAG_OIDC_TEAM_CLAIM=teamCodes
#UME_RAG_OIDC_GROUP_CLAIM=groups
#UME_RAG_OIDC_EXTRA_SCOPE=
#UME_RAG_OIDC_TENANT_ID=
#UME_RAG_OIDC_REFUSE_GUESTS=true
# Open WebUI's OIDC client (profile openwebui), redirect URI https://<chat host>/oauth/oidc/login/callback. Without a
# client secret from here or the wizard it signs in as a public client (PKCE); without any provider, not at all. RAG's
# Keycloak realm additions make open-webui a confidential client: enter its secret in the wizard's Open WebUI step, or here.
#UME_RAG_OPENWEBUI_OIDC_CLIENT_ID=open-webui
#UME_RAG_OPENWEBUI_OIDC_CLIENT_SECRET=
# default: rag-admin's authority + /.well-known/openid-configuration
#UME_RAG_OPENWEBUI_OIDC_PROVIDER_URL=
# the sign-in button's label, default Umeå kommun (also a setting in RAG's admin)
#UME_RAG_OPENWEBUI_OIDC_PROVIDER_NAME=

# ---- TLS proxy (profile proxy; docs/portainer.md, TLS proxy) -------------------------------------------------------
# a host directory with tls.crt and tls.key for all five host names, readable by uid 101
#UME_RAG_PROXY_CERTS_DIR=/etc/ume-rag/proxy-certs
#UME_RAG_PROXY_BIND=0.0.0.0
#UME_RAG_PROXY_PORT=443
