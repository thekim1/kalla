[Unit]
Description=Källa: restart containers labelled kalla.restart-unhealthy=true that are unhealthy
Documentation=file:@DEPLOY_DIR@/host/README.md
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# The deployment (its deploy/ directory and Compose project) from install.sh's host.env, so the unit follows the
# project and an upgrade's new directory (Decisions "Compose host layout and upgrades").
EnvironmentFile=@STATE_DIR@/host.env
ExecStart=/bin/sh -c 'exec "$$KALLA_DEPLOY_DIR/host/restart-unhealthy.sh"'
TimeoutStartSec=5min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
