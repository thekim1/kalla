[Unit]
Description=Källa: copy new uploads to the backup target (repo-and-deployment §7.4)
Documentation=file:@DEPLOY_DIR@/host/README.md
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# The deployment (its deploy/ directory and Compose project) from install.sh's host.env, so the unit follows the
# project and an upgrade's new directory (Decisions "Compose host layout and upgrades").
EnvironmentFile=@STATE_DIR@/host.env
ExecStart=/bin/sh -c 'exec "$$KALLA_DEPLOY_DIR/backup-uploads.sh" --env-file "$$KALLA_ENV_FILE"'
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
StateDirectory=kalla
StateDirectoryMode=0755
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
