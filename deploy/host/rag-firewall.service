# Applies the DOCKER-USER rules when Docker starts (and again when it restarts: PartOf), and from rag-firewall.timer,
# which re-resolves the allowed host names.
[Unit]
Description=Källa: host firewall for the Compose networks (repo-and-deployment §6.1)
Documentation=file:@DEPLOY_DIR@/host/README.md
Requires=docker.service
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
# The deployment (its deploy/ directory and Compose project) from install.sh's host.env, so the unit follows the
# project and an upgrade's new directory (Decisions "Compose host layout and upgrades").
EnvironmentFile=@STATE_DIR@/host.env
ExecStart=/bin/sh -c 'exec "$$KALLA_DEPLOY_DIR/host/docker-user-firewall.sh" --env-file "$$KALLA_ENV_FILE"'
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=docker.service
