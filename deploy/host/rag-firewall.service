# Applies the DOCKER-USER rules when Docker starts (and again when it restarts: PartOf), and from rag-firewall.timer,
# which re-resolves the allowed host names.
[Unit]
Description=Källa: host firewall for the Compose networks (repo-and-deployment §6.1)
Documentation=file:@DEPLOY_DIR@/host/README.md
Requires=docker.service
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
ExecStart=@DEPLOY_DIR@/host/docker-user-firewall.sh --env-file @DEPLOY_DIR@/.env
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=docker.service
