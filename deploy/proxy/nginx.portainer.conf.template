# The Portainer stack's TLS proxy (profile proxy; M-17 C8, Decisions "Deploy configuration" D9): nginx in front of the
# gateway, its admin, kalla-api, kalla-admin and Open WebUI, with the operator's certificate. kalla-bootstrap fills in the
# @placeholders@ from the stack's host names and writes kalla-config/proxy/nginx.conf; it drops the blocks marked
# #gwadmin, #ragadmin or #owui when that host has no name of its own (or the openwebui profile is off). Routes and body
# sizes as the gateway's and Källa's nginx.conf.example; every upstream but Open WebUI (plain HTTP inside the stack)
# is re-encrypted and verified against its internal CA.
worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    access_log /dev/stdout;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    server_tokens off;

    # Room for big response headers: the sign-in callback (/signin-oidc) sets the chunked session cookie and deletes
    # stale chunks and sign-in cookies in one response. With the old session still in the browser after a release, that
    # can exceed nginx's default 4 KB, and nginx answers 502 ("upstream sent too big header") until the user clears
    # their cookies. The buffer holds the response headers even where proxy_buffering is off. The browser sends the
    # cookies back on the next request, hence the larger request header buffers too.
    proxy_buffer_size 32k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;
    large_client_header_buffers 4 32k;

    # One certificate for every name (a SAN or wildcard certificate): KALLA_PROXY_CERTS_DIR/tls.crt and tls.key.
    ssl_certificate /run/proxy-certs/tls.crt;
    ssl_certificate_key /run/proxy-certs/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # WebSocket upgrade (the gateway's live audio, Open WebUI's live connection); other requests keep the pooled
    # keep-alive connection.
    map $http_upgrade $ume_connection { default upgrade; '' ''; }

    # Docker's embedded DNS, asked again every 10 s: a stack update recreates a service with a new address on its network
    # while this proxy keeps running, and a name resolved only at start would then answer 502 until a restart. With
    # "resolve" (nginx 1.27.3 and later) each upstream follows its service's current address, and a service that isn't up
    # yet (kalla-openwebui, which depends_on can't name across profiles) doesn't stop nginx from starting.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    upstream ume_gateway { zone ume_gateway 64k; server gateway:8443 resolve; keepalive 32; }
    upstream ume_admin { zone ume_admin 64k; server adminapi:8443 resolve; }
    upstream kalla_api { zone kalla_api 64k; server kalla-api:8443 resolve; keepalive 32; }
    upstream kalla_admin { zone kalla_admin 64k; server kalla-admin:8443 resolve; }
#owui    upstream kalla_openwebui { zone kalla_openwebui 64k; server kalla-openwebui:8080 resolve; }

    # A name this proxy doesn't serve gets no answer.
    server {
        listen 8443 ssl default_server;
        http2 on;
        return 444;
    }

    # The gateway (its deploy/proxy/nginx.conf.example).
#gateway    server {
#gateway        listen 8443 ssl;
#gateway        http2 on;
#gateway        server_name @GATEWAY_HOST@;
#gateway        client_max_body_size 52m;          # image edits (gateway default 50 MB), audio uploads (26 MB), documents
#gateway        location / {
#gateway            proxy_pass https://ume_gateway;
#gateway            proxy_http_version 1.1;
#gateway            proxy_set_header Upgrade $http_upgrade;
#gateway            proxy_set_header Connection $ume_connection;
#gateway            proxy_set_header Host $host;
#gateway            # List this proxy under the gateway admin's Settings > Trusted proxies, or the gateway ignores the header.
#gateway            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#gateway            proxy_buffering off;           # stream tokens as they arrive (SSE)
#gateway            proxy_request_buffering off;   # uploads straight through: no recordings in proxy temp files
#gateway            proxy_read_timeout 600s;
#gateway            proxy_send_timeout 600s;
#gateway            proxy_connect_timeout 5s;
#gateway            proxy_ssl_verify on;
#gateway            proxy_ssl_trusted_certificate /etc/nginx/kalla/gateway-ca.pem;
#gateway            proxy_ssl_name gateway;
#gateway            proxy_ssl_server_name on;
#gateway        }
#gateway    }

    # The gateway's admin UI and API.
#gwadmin    server {
#gwadmin        listen 8443 ssl;
#gwadmin        http2 on;
#gwadmin        server_name @ADMIN_HOST@;
#gwadmin        location / {
#gwadmin            proxy_pass https://ume_admin;
#gwadmin            proxy_http_version 1.1;
#gwadmin            proxy_set_header Host $host;
#gwadmin            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#gwadmin            proxy_connect_timeout 5s;
#gwadmin            proxy_ssl_verify on;
#gwadmin            proxy_ssl_trusted_certificate /etc/nginx/kalla/gateway-ca.pem;
#gwadmin            proxy_ssl_name adminapi;
#gwadmin            proxy_ssl_server_name on;
#gwadmin        }
#gwadmin    }

    # kalla-api: chat completions (streamed), knowledge, MCP, the OpenAI-compatible model list.
#ragapi    server {
#ragapi        listen 8443 ssl;
#ragapi        http2 on;
#ragapi        server_name @API_HOST@;
#ragapi        client_max_body_size 2m;           # questions and chat history (kalla-api's chat route takes up to 2 MB)
#ragapi        # kalla-api's internal routes (Open WebUI's sign-in settings) are for the stack's own network only.
#ragapi        location /internal/ { return 404; }
#ragapi        location / {
#ragapi            proxy_pass https://kalla_api;
#ragapi            proxy_http_version 1.1;
#ragapi            proxy_set_header Connection '';
#ragapi            proxy_set_header Host $host;
#ragapi            # List this proxy under Källa's Settings > Network (trusted proxies), or kalla-api ignores the header.
#ragapi            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#ragapi            proxy_buffering off;           # stream answer tokens as they arrive (SSE)
#ragapi            proxy_read_timeout 600s;
#ragapi            proxy_send_timeout 600s;
#ragapi            proxy_connect_timeout 5s;
#ragapi            proxy_ssl_verify on;
#ragapi            proxy_ssl_trusted_certificate /etc/nginx/kalla/rag-ca.pem;
#ragapi            proxy_ssl_name kalla-api;
#ragapi            proxy_ssl_server_name on;
#ragapi        }
#ragapi    }

    # kalla-admin: the admin UI and its API (BFF).
#ragadmin    server {
#ragadmin        listen 8443 ssl;
#ragadmin        http2 on;
#ragadmin        server_name @RAG_ADMIN_HOST@;
#ragadmin        client_max_body_size 1m;
#ragadmin        location / {
#ragadmin            proxy_pass https://kalla_admin;
#ragadmin            proxy_http_version 1.1;
#ragadmin            proxy_set_header Host $host;
#ragadmin            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#ragadmin            proxy_connect_timeout 5s;
#ragadmin            proxy_ssl_verify on;
#ragadmin            proxy_ssl_trusted_certificate /etc/nginx/kalla/rag-ca.pem;
#ragadmin            proxy_ssl_name kalla-admin;
#ragadmin            proxy_ssl_server_name on;
#ragadmin        }
#ragadmin        # Uploads (admin design §2.2): one file per request, up to 60 MB, passed straight through.
#ragadmin        location ~ ^/api/upload-batches/[0-9a-fA-F-]+/files/[0-9]+$ {
#ragadmin            client_max_body_size 60m;
#ragadmin            proxy_request_buffering off;
#ragadmin            proxy_pass https://kalla_admin;
#ragadmin            proxy_http_version 1.1;
#ragadmin            proxy_set_header Host $host;
#ragadmin            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#ragadmin            proxy_read_timeout 300s;
#ragadmin            proxy_send_timeout 300s;
#ragadmin            proxy_connect_timeout 5s;
#ragadmin            proxy_ssl_verify on;
#ragadmin            proxy_ssl_trusted_certificate /etc/nginx/kalla/rag-ca.pem;
#ragadmin            proxy_ssl_name kalla-admin;
#ragadmin            proxy_ssl_server_name on;
#ragadmin        }
#ragadmin    }

    # Open WebUI (profile openwebui): plain HTTP inside the stack; this proxy terminates TLS.
#owui    server {
#owui        listen 8443 ssl;
#owui        http2 on;
#owui        server_name @OPENWEBUI_HOST@;
#owui        client_max_body_size 2m;       # the whole conversation goes to kalla-api (2 MB); file uploads are off
#owui        location / {
#owui            proxy_pass http://kalla_openwebui;
#owui            proxy_http_version 1.1;
#owui            proxy_set_header Upgrade $http_upgrade;
#owui            proxy_set_header Connection $ume_connection;
#owui            proxy_set_header Host $host;
#owui            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#owui            proxy_set_header X-Forwarded-Proto https;
#owui            proxy_buffering off;       # stream answers
#owui            proxy_read_timeout 600s;
#owui            proxy_send_timeout 600s;
#owui            proxy_connect_timeout 5s;
#owui        }
#owui    }
}
