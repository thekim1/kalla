# nginx of your own in front of Källa on a Compose host (re-encrypting to the HTTPS listeners), in the shape of the
# gateway's deploy/proxy (#468); the stack's own TLS proxy is the profile proxy. Fill in the @placeholders@ (@UPSTREAM@:
# the address this proxy reaches the Compose host at; the ports are deploy/.env's), and enable the lines marked #owui
# with the profile openwebui and #rolling with compose.rolling.yaml. Add your own ssl_certificate / ssl_certificate_key
# (your PKI or Let's Encrypt). Pass the Host header through unchanged: the admin UI builds its OIDC redirect URIs from it.
# Restrict the published ports to this proxy: init-deployment.sh --proxy-address (the host firewall) or a network firewall.

# WebSocket upgrade (Open WebUI's live connection); other requests keep the pooled keep-alive connection.
map $http_upgrade $kalla_connection { default upgrade; '' ''; }

# Room for big response headers: the sign-in callback (/signin-oidc) sets the chunked session cookie and deletes
# stale chunks and sign-in cookies in one response. With the old session still in the browser after a release, that
# can exceed nginx's default 4 KB, and nginx answers 502 ("upstream sent too big header") until the user clears
# their cookies. The buffer holds the response headers even where proxy_buffering is off. The browser sends the
# cookies back on the next request, hence the larger request header buffers too.
proxy_buffer_size 32k;
proxy_buffers 8 32k;
proxy_busy_buffers_size 64k;
large_client_header_buffers 4 32k;

# With compose.rolling.yaml (init-deployment.sh --rolling) kalla-api and kalla-admin have a second slot; nginx sends
# requests to both and retries on the other when one fails while it is replaced (proxy_next_upstream below).
# See docs/zero-downtime-updates.md.
upstream kalla_api {
    server @UPSTREAM@:@API_PORT@;
    #rolling server @UPSTREAM@:@API_B_PORT@;
    keepalive 32;
}
upstream kalla_admin {
    server @UPSTREAM@:@ADMIN_PORT@;
    #rolling server @UPSTREAM@:@ADMIN_B_PORT@;
}
#owui upstream kalla_openwebui {
#owui     server @UPSTREAM@:@OPENWEBUI_PORT@;
#owui }

# kalla-api: chat completions (streamed), knowledge, MCP, the OpenAI-compatible model list.
server {
    listen 443 ssl;
    http2 on;
    server_name @API_HOST@;
    # ssl_certificate     /etc/ssl/@API_HOST@.crt;
    # ssl_certificate_key /etc/ssl/@API_HOST@.key;

    client_max_body_size 2m;           # questions and chat history (kalla-api's chat route takes up to 2 MB); never files
    location / {
        proxy_pass https://kalla_api;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        # The client's address, for key IP allow-lists and security events. List this proxy under the trusted proxies
        # (admin UI, Settings, Network), or kalla-api ignores the header.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;           # stream answer tokens as they arrive (SSE)
        proxy_read_timeout 600s;       # long answers
        proxy_send_timeout 600s;
        # Retry on the other slot (--rolling) when a connection fails before any response, also for POST
        # (non_idempotent): a slot being replaced resets connections it accepted but never read, so the request did not
        # run. Only within 10 s, so a request that ran long and then failed is never repeated. Harmless with one slot.
        proxy_next_upstream error timeout non_idempotent;
        proxy_next_upstream_timeout 10s;
        proxy_next_upstream_tries 2;
        proxy_connect_timeout 5s;
        # The listener presents the internal CA's certificate. To verify it, copy ca.pem out of the kalla-certs volume to the proxy (docs/production-setup.md, step 5) and enable:
        # proxy_ssl_verify on; proxy_ssl_trusted_certificate /etc/ssl/kalla-internal-ca.pem;
        # proxy_ssl_name kalla-api;
    }
}

# kalla-admin: the admin UI and its API (BFF).
server {
    listen 443 ssl;
    http2 on;
    server_name @ADMIN_HOST@;
    # ssl_certificate     /etc/ssl/@ADMIN_HOST@.crt;
    # ssl_certificate_key /etc/ssl/@ADMIN_HOST@.key;

    client_max_body_size 1m;
    location / {
        proxy_pass https://kalla_admin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_next_upstream error timeout non_idempotent;  # as for kalla-api
        proxy_next_upstream_timeout 10s;
        proxy_next_upstream_tries 2;
        proxy_connect_timeout 5s;
        # proxy_ssl_verify on; proxy_ssl_trusted_certificate /etc/ssl/kalla-internal-ca.pem;
        # proxy_ssl_name kalla-admin;
    }
    # Uploads (admin design §2.2): one file per request, up to 60 MB, passed straight through (no proxy temp files).
    location ~ ^/api/upload-batches/[0-9a-fA-F-]+/files/[0-9]+$ {
        client_max_body_size 60m;
        proxy_request_buffering off;
        proxy_pass https://kalla_admin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 5s;
    }
}

# Open WebUI (the profile openwebui): plain HTTP on the host; this proxy terminates TLS.
#owui server {
#owui     listen 443 ssl;
#owui     http2 on;
#owui     server_name @OPENWEBUI_HOST@;
#owui     # ssl_certificate     /etc/ssl/@OPENWEBUI_HOST@.crt;
#owui     # ssl_certificate_key /etc/ssl/@OPENWEBUI_HOST@.key;
#owui
#owui     client_max_body_size 2m;           # the whole conversation goes to kalla-api (2 MB); file uploads are off
#owui     location / {
#owui         proxy_pass http://kalla_openwebui;
#owui         proxy_http_version 1.1;
#owui         proxy_set_header Upgrade $http_upgrade;  # its live connection (WebSocket)
#owui         proxy_set_header Connection $kalla_connection;
#owui         proxy_set_header Host $host;
#owui         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#owui         proxy_set_header X-Forwarded-Proto https;
#owui         proxy_buffering off;           # streamed answers
#owui         proxy_read_timeout 600s;
#owui         proxy_connect_timeout 5s;
#owui     }
#owui }
