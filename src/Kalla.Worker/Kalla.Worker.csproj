<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>ume-rag-worker</UserSecretsId>
    <ContainerRepository>ume-rag/worker</ContainerRepository>
    <KallaServiceContainer>true</KallaServiceContainer>
  </PropertyGroup>
  <ItemGroup>
    <!-- Processing stages (processing design §2–§11): HTML extraction, Markdown blocks, the BGE-M3 token counter. -->
    <PackageReference Include="AngleSharp" />
    <!-- The scheduler's cron (engine design §9.6, Europe/Stockholm). -->
    <PackageReference Include="Cronos" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <!-- The renderer's client (connectors design §8.3); it ships Playwright's Node driver, run as a child of the worker. -->
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kalla.Worker.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Detect's stop-word lists (no culture-like '.sv.' in the names: MSBuild would move them to a satellite assembly); BGE-M3's SentencePiece model (Processing/Chunking/bge-m3/README.md: source, revision, licence, SHA-256). -->
    <EmbeddedResource Include="Processing\Detect\stopwords-sv.txt" LogicalName="Kalla.Worker.Processing.Detect.stopwords-sv.txt" />
    <EmbeddedResource Include="Processing\Detect\stopwords-en.txt" LogicalName="Kalla.Worker.Processing.Detect.stopwords-en.txt" />
    <EmbeddedResource Include="Processing\Chunking\bge-m3\sentencepiece.bpe.model" LogicalName="Kalla.Worker.Processing.Chunking.bge-m3.sentencepiece.bpe.model" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kalla.Infrastructure\Kalla.Infrastructure.csproj" />
    <ProjectReference Include="..\Kalla.ServiceDefaults\Kalla.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Kalla.Pipelines\Kalla.Pipelines.csproj" />
    <ProjectReference Include="..\Kalla.Retrieval\Kalla.Retrieval.csproj" />
  </ItemGroup>
</Project>
