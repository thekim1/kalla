<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>ume-rag-adminapi</UserSecretsId>
    <ContainerRepository>ume-rag/admin</ContainerRepository>
    <UmeServiceContainer>true</UmeServiceContainer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAdminUi)' == 'true'">
    <Content Include="..\admin-ui\dist\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireAdminUiAssets" BeforeTargets="Publish" Condition="'$(PublishAdminUi)' == 'true'">
    <Error Condition="!Exists('..\admin-ui\dist\index.html')" Text="Build src\admin-ui before publishing with PublishAdminUi=true." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Ume.Rag.Infrastructure\Ume.Rag.Infrastructure.csproj" />
    <ProjectReference Include="..\Ume.Rag.ServiceDefaults\Ume.Rag.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Ume.Rag.Answering\Ume.Rag.Answering.csproj" />
    <ProjectReference Include="..\Ume.Rag.Pipelines\Ume.Rag.Pipelines.csproj" />
  </ItemGroup>
</Project>
