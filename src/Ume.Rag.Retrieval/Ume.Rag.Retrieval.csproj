<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Ume.Rag.Domain\Ume.Rag.Domain.csproj" />
    <ProjectReference Include="..\Ume.Rag.Infrastructure\Ume.Rag.Infrastructure.csproj" />
    <ProjectReference Include="..\Ume.Rag.Pipelines\Ume.Rag.Pipelines.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Already pinned for P0 #6 (to-verify #13): UseVector() for the query vector parameter (knowledge design §6.6). -->
    <PackageReference Include="Pgvector" />
  </ItemGroup>
  <ItemGroup>
    <!-- The sv_SE Hunspell word list for SwedishDecompounder (Text/sv_SE/README.md: source, version, licence). LGPL-3.0-only:
         shipped as separate, replaceable files with their notices and the LGPL-3.0 and GPL-3.0 texts (LGPL-3 section 4,
         #52), in dictionaries/sv_SE/ next to every assembly that uses Ume.Rag.Retrieval, and so in every .NET image. -->
    <Content Include="Text\sv_SE\*" Link="dictionaries\sv_SE\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
