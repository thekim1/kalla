<Project Sdk="Aspire.AppHost.Sdk/13.6.5">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>ume-rag-apphost-dev</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Aspire.Hosting.Keycloak" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.Python" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>
  <ItemGroup>
    <!-- Health endpoint paths, shared with the services without referencing ServiceDefaults (the type is internal on both sides). -->
    <Compile Include="..\Kalla.ServiceDefaults\HealthEndpoints.cs" Link="HealthEndpoints.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kalla.AdminApi\Kalla.AdminApi.csproj" />
    <ProjectReference Include="..\Kalla.Api\Kalla.Api.csproj" />
    <ProjectReference Include="..\Kalla.FakeGateway\Kalla.FakeGateway.csproj" />
    <ProjectReference Include="..\Kalla.MigrationService\Kalla.MigrationService.csproj" />
    <ProjectReference Include="..\Kalla.Worker\Kalla.Worker.csproj" />
  </ItemGroup>
</Project>
