{
  "template": "files",
  "version": 1,
  "sourceType": "upload",
  "stages": {
    "fetch": 1,
    "scan": 1,
    "detect": 1,
    "parse": 1,
    "clean": 1,
    "chunk": 1,
    "personal-data": 1,
    "embed": 1,
    "index": 1
  },
  "parameters": {
    "ocr": {
      "stage": "parse",
      "appliesTo": [
        "parser"
      ],
      "schema": {
        "enum": [
          "auto",
          "force",
          "off"
        ]
      },
      "default": "auto"
    },
    "tables": {
      "stage": "parse",
      "appliesTo": [
        "parser"
      ],
      "schema": {
        "enum": [
          "fast",
          "accurate"
        ]
      },
      "default": "accurate"
    },
    "chunkTokens": {
      "stage": "chunk",
      "schema": {
        "type": "integer",
        "minimum": 200,
        "maximum": 800
      },
      "default": 400
    },
    "overlapPercent": {
      "stage": "chunk",
      "schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 30
      },
      "default": 15
    },
    "pathRules": {
      "stage": "chunk",
      "schema": {
        "$ref": "#/$defs/pathRules"
      },
      "default": []
    }
  },
  "labels": {
    "pathRules": {
      "sv": "Ämnen",
      "en": "Topics"
    }
  },
  "defs": {
    "pathRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match",
        "on"
      ],
      "properties": {
        "match": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "on": {
          "enum": [
            "path",
            "path-regex",
            "host",
            "title-regex",
            "mediaType"
          ]
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[\\p{L}\\p{N}-]{1,50}$"
          }
        },
        "documentType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "date": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "if": {
        "properties": {
          "on": {
            "enum": [
              "path-regex",
              "title-regex"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "match": {
            "format": "regex"
          }
        }
      }
    },
    "pathRules": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/pathRule"
      }
    }
  }
}
