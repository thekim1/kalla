<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>kalla-adminapi</UserSecretsId>
    <ContainerRepository>kalla/admin</ContainerRepository>
    <KallaServiceContainer>true</KallaServiceContainer>
    <!-- The minimal API's request delegates generated at build time, not compiled from expression trees and JIT-compiled
         by every host at start (the test hosts' JIT time, #1084). -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <!-- RDG011: the two generic settings endpoints (SettingsEndpoints) are generated at run time instead, as before. -->
    <NoWarn>$(NoWarn);RDG011</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAdminUi)' == 'true'">
    <Content Include="..\admin-ui\dist\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireAdminUiAssets" BeforeTargets="Publish" Condition="'$(PublishAdminUi)' == 'true'">
    <Error Condition="!Exists('..\admin-ui\dist\index.html')" Text="Build src\admin-ui before publishing with PublishAdminUi=true." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Kalla.Infrastructure\Kalla.Infrastructure.csproj" />
    <ProjectReference Include="..\Kalla.ServiceDefaults\Kalla.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Kalla.Answering\Kalla.Answering.csproj" />
    <ProjectReference Include="..\Kalla.Pipelines\Kalla.Pipelines.csproj" />
  </ItemGroup>
</Project>
