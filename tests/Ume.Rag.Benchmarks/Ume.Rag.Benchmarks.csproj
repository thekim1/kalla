<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Hot-path benchmarks (BenchmarkDotNet), run by hand only: not in UmeRag.slnx, so no pipeline builds or runs them.
    See README.md for when to run them and how.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- BenchmarkDotNet needs public, non-sealed benchmark classes and instance methods (as the gateway's benchmarks). -->
    <NoWarn>$(NoWarn);CA1001;CA1707;CA1515;CA1812;CA1852;CA2000;CA5394;CA1861;CA2234;CA1822;CA1849</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ume.Rag.Retrieval\Ume.Rag.Retrieval.csproj" />
    <ProjectReference Include="..\..\src\Ume.Rag.Answering\Ume.Rag.Answering.csproj" />
    <ProjectReference Include="..\..\src\Ume.Rag.Worker\Ume.Rag.Worker.csproj" />
    <ProjectReference Include="..\..\src\Ume.Rag.Api\Ume.Rag.Api.csproj" />
    <ProjectReference Include="..\Ume.Rag.TestKit\Ume.Rag.TestKit.csproj" />
  </ItemGroup>
</Project>
