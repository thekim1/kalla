        87.9,
        306.0,
        100.9
      ],
      "layer": "body",
      "md": "# Bilaga: Avgifter och handläggningstider",
      "ref": "#/texts/14",
      "table": null
    },
    {
      "id": "b15",
      "kind": "paragraph",
      "level": null,
