        64.0,
        119.0,
        447.9,
        129.2
      ],
      "layer": "body",
      "md": "Tabellen visar avgifter enligt taxan för år 2027 och normala handläggningstider.",
      "ref": "#/texts/15",
      "table": null
    },
    {
