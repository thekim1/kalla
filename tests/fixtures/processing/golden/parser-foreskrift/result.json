   "bbox": [
    56.0,
    250,
    500.0,
    264
   ],
   "layer": "body",
   "md": "Den som ställer ut en container på offentlig plats ska se till att containern är tydligt märkt med ägarens namn och telefonnummer.",
   "ref": null,
   "table": null
  },
