    56.0,
    140,
    500.0,
    154
   ],
   "layer": "body",
   "md": "Arbete som orsakar störande buller för omkringboende, t.ex. med kompressorer, pålningsmaskiner eller stenkrossar, får inte utföras nattetid mellan klockan 22.00 och 07.00 utan tillstånd av polismyndigheten.",
   "ref": null,
   "table": null
  },
  {
   "id": "b16",
   "kind": "heading",
   "level": 1,
   "level_source": "font_size",
